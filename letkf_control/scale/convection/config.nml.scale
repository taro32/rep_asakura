#####
#
# SCALE-RM run configulation（convection cycle 用テンプレート）
#
# scale-rm/test/case/rep_asakura/run.conf から作成（2026-09-25）。
# 物理設定・格子・時間ステップ・history の項目は rep_asakura と同じ。変更点:
#   - !--XXX-- の行に cycle スクリプトが値を差し込む（時刻・入出力パス・出力間隔）
#   - 放射・陸面の入力は convection/dat/ の絶対パス
#   - history: LETKC・obsmake・LETKF が読む Umet, Vmet, SFC_PRES, U10m, V10m を追加。
#     ファイル名に時刻が付かないように FILE_HISTORY_OUTPUT_SWITCH_* を外した。
#     初期時刻も出力する（FILE_HISTORY_OUTPUT_STEP0 = .true.、case_tc と同じ）
#   - refstate は出力しない（ATMOS_REFSTATE_OUT_BASENAME を外した）
#
#####

&PARAM_IO
!--IO_LOG_BASENAME--
/

&PARAM_PRC_CARTESC
 PRC_NUM_X = 12,
 PRC_NUM_Y = 12,
 PRC_PERIODIC_X = .true.,
 PRC_PERIODIC_Y = .true.,
/

&PARAM_ATMOS_GRID_CARTESC_INDEX
 KMAX = 64,
 IMAX = 10,
 JMAX = 10,
 IHALO = 2,
 JHALO = 2,
/

&PARAM_ATMOS_GRID_CARTESC
! DX        = 500.D0,
! DX        = 1000.D0,
! DX        = 1500.D0,
! DX        = 1750.D0,
! DX        = 1875.D0,
 DX        = 2000.D0,
! DX        = 3000.D0,
! DX        = 4000.D0,
! DY        = 500.D0,
! DY        = 1000.D0,
! DY        = 1500.D0,
! DY        = 1750.D0,
! DY        = 1875.D0,
 DY        = 2000.D0,
! DY        = 3000.D0,
! DY        = 4000.D0,
 FZ(:) = 75.0000D0, 153.4500D0, 235.5087D0, 321.3421D0, 411.1238D0,
        505.0355D0, 603.2672D0, 706.0175D0, 813.4943D0, 925.9150D0,
        1043.5071D0, 1166.5084D0, 1295.1678D0, 1429.7456D0, 1570.5139D0,
        1717.7576D0, 1871.7744D0, 2032.8760D0, 2201.3882D0, 2377.6519D0,
        2562.0237D0, 2754.8767D0, 2956.6011D0, 3167.6047D0, 3388.3145D0,
        3619.1768D0, 3860.6587D0, 4113.2490D0, 4377.4585D0, 4653.8218D0,
        4942.8979D0, 5245.2715D0, 5561.5542D0, 5892.3857D0, 6238.4355D0,
        6600.4038D0, 6979.0225D0, 7375.0576D0, 7789.3105D0, 8222.6191D0,
        8675.8604D0, 9149.9502D0, 9645.8486D0, 10164.5586D0, 10707.1289D0,
        11274.6572D0, 11868.2920D0, 12468.2920D0, 13068.2920D0, 13668.2920D0,
        14268.2920D0, 14868.2920D0, 15468.2920D0, 16068.2920D0, 16668.2930D0,
        17304.7148D0, 17979.7676D0, 18695.7969D0, 19455.2891D0, 20260.8828D0,
        21115.3770D0, 22021.7383D0, 22983.1152D0, 24000.0000D0,
/


&PARAM_LAND_GRID_CARTESC_INDEX
 LKMAX = 7,
/

&PARAM_LAND_GRID_CARTESC
 LDZ = 0.05D0, 0.15D0, 0.3D0, 0.5D0, 1.D0, 1.D0, 1.D0,
/

&PARAM_TIME
!--TIME_STARTDATE--
 TIME_STARTMS               = 0.D0,
!--TIME_DURATION--
 TIME_DURATION_UNIT         = "SEC",
! TIME_DT                    = 2.0D0,
! TIME_DT                    = 3.0D0,
