 ATMOS_SOLARINS_set_ve = .false.,
 ATMOS_SOLARINS_set_ideal = .true.,
 ATMOS_SOLARINS_obliquity = 0.0,
 ATMOS_SOLARINS_eccentricity = 0.0,
 ATMOS_SOLARINS_fixedlatlon = .true.,
 ATMOS_SOLARINS_lon = 0.0,
 ATMOS_SOLARINS_lat = 0.0,
