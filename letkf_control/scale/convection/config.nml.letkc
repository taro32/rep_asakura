&PARAM_LOG
 LOG_LEVEL = 1, 
/

&PARAM_OBSOPE
!--OBS_IN_NUM--
!--OBS_IN_NAME--
!--OBS_IN_FORMAT--
 OBS_IN_FORMAT="PREPBUFR", 
!--OBSDA_RUN--
!--HISTORY_IN_BASENAME--
!--SLOT_START--
!--SLOT_END--
!--SLOT_BASE--
!--SLOT_TINTERVAL--
/

&PARAM_LETKF
!--OBSDA_IN--
!--OBSDA_IN_BASENAME--
!--GUES_IN_BASENAME--
!--GUES_MEAN_INOUT_BASENAME--
!--GUES_SPRD_OUT_BASENAME--
!--GUES_SPRD_OUT--
!--ANAL_OUT_BASENAME--
!--ANAL_SPRD_OUT--
 INFL_MUL = 1.0D0,
! INFL_MUL_MIN = 0.0D0,
!--INFL_MUL_ADAPTIVE--
!--INFL_MUL_IN_BASENAME--
!--INFL_MUL_OUT_BASENAME--
!--INFL_ADD--
!--INFL_ADD_IN_BASENAME--
INFL_ADD_SHUFFLE = .true.,
INFL_ADD_Q_RATIO = .true.,
INFL_ADD_REF_ONLY = .true.,
 RELAX_ALPHA = 1.0D0,
! RELAX_ALPHA_SPREAD = 0.0D0,
!--RELAX_SPREAD_OUT--
!--RELAX_SPREAD_OUT_BASENAME--
 RELAX_TO_INFLATED_PRIOR = .true.,
 GROSS_ERROR = 1000000.0D0, ! no QC for LETKC
 Q_UPDATE_TOP = 150.0D2,
 Q_SPRD_MAX = 0.5D0,
 BOUNDARY_BUFFER_WIDTH = 0.0D3, 
 POSITIVE_DEFINITE_Q = .true.,    
 POSITIVE_DEFINITE_QHYD = .true., 
!--NOBS_OUT--
!--NOBS_OUT_BASENAME--
 FILL_BY_ZERO_MISSING_VARAIBLES = T,
/

&PARAM_LETKF_OBS
 HORI_LOCAL =   2.0D4, ! 20 km（仮。影響は約 73 km 先でゼロ）。case_tc は 1.5D5 だが、240 km 四方の領域では領域全体に届くので小さくした。制御指標を決めるときに見直す
 VERT_LOCAL =   0.3D2 !0.3D0, !0.3D1 0.3D0
! TIME_LOCAL = 3.0D0,
! MAX_NOBS_PER_GRID = 100,
/

&PARAM_LETKF_MONITOR
 DEPARTURE_STAT = .true.
! DEPARTURE_STAT_T_RANGE = 0.0d0
!--OBSDEP_OUT--
!--OBSDEP_OUT_BASENAME--
/

!*** Attach SCALE configuration below ***

&PARAM_IO
!--IO_LOG_BASENAME--
 IO_LOG_ALLNODE = .false.,
/

