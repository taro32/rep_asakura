#####
#
# SCALE-RM mkinit configulation for tropical cyclone test
#
#####

&PARAM_IO
!--IO_LOG_BASENAME--
/

&PARAM_PRC_CARTESC
 PRC_NUM_X = 2,
 PRC_NUM_Y = 2,
/

&PARAM_ATMOS_GRID_CARTESC_INDEX
 KMAX = 40,
 IMAX = 50,
 JMAX = 50,
 IHALO = 2,
 JHALO = 2,
/

&PARAM_ATMOS_GRID_CARTESC
 DX        = 5000.0D0,
 DY        = 5000.0D0,
 DZ        = 500.0D0,
 BUFFER_DZ = 3000.0D0,
 BUFFFACT  = 1.1D0,
/

&PARAM_TIME
!--TIME_STARTDATE--
 TIME_STARTMS               = 0.D0,
/


&PARAM_RESTART
!--RESTART_OUT_BASENAME--
 RESTART_OUTPUT       = .true.,
/

&PARAM_STATISTICS
 STATISTICS_checktotal     = .true.,
 STATISTICS_use_globalcomm = .true.,
/

&PARAM_ATMOS
 ATMOS_DYN_TYPE    = "HEVI",
 ATMOS_PHY_MP_TYPE = "TOMITA08",
 ATMOS_PHY_TB_TYPE = "SMAGORINSKY",
 ATMOS_PHY_BL_TYPE = "MYNN",
 ATMOS_PHY_SF_TYPE = "BULK"
 ATMOS_PHY_CP_TYPE = "OFF",
/

&PARAM_MKINIT
 MKINIT_initname = "TROPICALCYCLONE",
/

&PARAM_MKINIT_SOUNDING
 ENV_IN_SOUNDING_file = "dat/tropicalcyclone.txt",
/

&PARAM_BUBBLE
 BBL_CZ =  1.5D3,
 BBL_CX = 75.0D3,
 BBL_CY = 75.0D3,
 BBL_RZ =  3.0D3,
 BBL_RX = 25.0D3,
 BBL_RY = 25.0D3,
/

&PARAM_MKINIT_TROPICALCYCLONE
 NR    =      300    ! number of radial grid [-]
 MWS   =   20.E+0    ! maximum wind speed [m s-1]
 RMW   =  120.E+3    ! radius of maximum wind [m]
 R0    =  750.E+3    ! outermost radius [m]
 F0    =    5.E-5    ! Coriolis parameter [s-1]
 ZTOP  =   15.E+3    ! top height of vortex [m]
 VORTEX_CX =  1000.E+3 ! center of vortex [m]
 VORTEX_CY =  1000.E+3 ! center of vortex [m]
/
